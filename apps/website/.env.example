# Used for PostgreSQL Docker Container
#POSTGRES_USER=
#POSTGRES_PASSWORD=
#POSTGRES_DB=

# For Prisma ORM connection
# DATABASE_URL=

# For Auth.JS
# AUTH_SECRET=

# For E-mail sending
# SMTP_SERVER_HOST=
# SMTP_SERVER_PORT=
# SMTP_SERVER_USER=
# SMTP_SERVER_PASSWORD=
# EMAIL_FROM= -> The `from` field when sending e-mails

# For Stripe payments
# STRIPE_SECRET_KEY=
# NEXT_PUBLIC_STRIPE_PRICE_BASIC=
# NEXT_PUBLIC_STRIPE_PRICE_BASIC_BRAZIL=
# NEXT_PUBLIC_STRIPE_PRICE_COMPLETE=
# NEXT_PUBLIC_STRIPE_PRICE_COMPLETE_BRAZIL=
# NEXT_PUBLIC_STRIPE_PRICE_UPGRADE_PLAN=
# NEXT_PUBLIC_STRIPE_PRICE_UPGRADE_PLAN_BRAZIL=
# STRIPE_SUCCESS_URL=
# STRIPE_WEBHOOK_ENDPOINT_SECRET=

# For Mercado Pago payments
# MERCADOPAGO_ACCESS_TOKEN=
# DISCLY_BASIC_PLAN_PRICE= -> amount in reals
# DISCLY_UNLIMITED_PLAN_PRICE= -> amount in reals

# For Discord OAuth2
# NEXT_PUBLIC_DISCORD_OAUTH_CLIENT_ID=
# NEXT_PUBLIC_DISCORD_OAUTH_REDIRECT_URL=
# DISCORD_OAUTH_CLIENT_SECRET=
# NEXT_PUBLIC_DISCORD_OAUTH_URL="https://discord.com/oauth2/authorize?client_id=$NEXT_PUBLIC_DISCORD_OAUTH_CLIENT_ID&redirect_uri=$NEXT_PUBLIC_DISCORD_OAUTH_REDIRECT_URL&response_type=code&scope=identify+guilds"

# BASE_URL=https://discly.live

# For Discord logging
# IS_LOGGING_ENABLED=true/false
# PASSWORD_CHANGE_WEBHOOK_URL=
# PASSWORD_RESET_WEBHOOK_URL=
# PURCHASE_WEBHOOK_URL=
